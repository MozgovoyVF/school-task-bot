NODE_ENV=production
APP_ENV=dev                      # dev | prod
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling            # polling | webhook (фаза 5)
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
SUPERADMIN_TG_IDS=123456789      # через запятую
# BOOTSTRAP_OWNER_TG_ID: только dev
BOOTSTRAP_OWNER_TG_ID=
DEFAULT_WORKSPACE_NAME=Школа
DEFAULT_TIMEZONE=Europe/Moscow
DATABASE_URL=postgres://stb:***@db:5432/stb
MIGRATE_ON_START=true
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# LLM_MODEL_PRIMARY: по результатам eval
LLM_MODEL_PRIMARY=
LLM_MODEL_FALLBACK=
LLM_DAILY_BUDGET_USD=1.0
AI_PREFILTER=off                 # off | jev | llm
AI_PREFILTER_THRESHOLD=0.15
TYPESAFE_API_KEY=
HTTP_PORT=3000                   # в Docker: порт на хосте (dev 3000, prod 3001), в контейнере всегда 3000
# PUBLIC_BASE_URL: фаза 5+
PUBLIC_BASE_URL=
# BACKUP_AGE_RECIPIENT: публичный ключ age
BACKUP_AGE_RECIPIENT=
GIT_SHA=dev                      # подставляется при сборке образа

# --- Только для Docker Compose (docker/compose.yml -> сервис db, scripts/*.sh).
# Не входит в SPEC §26, не валидируется src/config/env.ts/EnvSchema. См. plan.md → D37, D38.
POSTGRES_USER=stb
# POSTGRES_PASSWORD: openssl rand -hex 24 (без / + @ : $); должен совпадать с DATABASE_URL выше
POSTGRES_PASSWORD=
POSTGRES_DB=stb
COMPOSE_PROJECT=stb-dev          # stb-dev | stb-prod
